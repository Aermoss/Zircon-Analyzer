{
    "name": "zircon-analyzer",
    "displayName": "Zircon Analyzer",
    "description": "Zircon language support for Visual Studio Code.",
    "publisher": "bithynia",
    "version": "0.5.1",
    "engines": {
        "vscode": "^1.103.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Aermoss/Zircon-Analyzer"
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc --watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "contributes": {
        "configuration": {
            "title": "Zircon",
            "properties": {
                "zircon.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the zirconc compiler executable. If empty, zirconc is searched on the system PATH, in bin/ of the workspace folder and in ../Zircon/bin/ next to it."
                },
                "zircon.includePath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional Zircon include directory. Defaults to ../include relative to the compiler executable."
                },
                "zircon.includePaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "scope": "resource",
                    "description": "Additional include directories passed to zirconc with -I, like -Isrc in a Makefile. Relative paths are resolved against the workspace folder."
                }
            }
        },
        "languages": [
            {
                "id": "zircon",
                "aliases": [
                    "Zircon"
                ],
                "extensions": [
                    ".zir"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "zircon",
                "scopeName": "source.zircon",
                "path": "./syntaxes/zircon.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "zircon",
                "path": "./snippets/zircon.json"
            }
        ],
        "taskDefinitions": [
            {
                "type": "zircon",
                "required": [
                    "file"
                ],
                "properties": {
                    "file": {
                        "type": "string",
                        "description": "The Zircon file to compile and run."
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "zircon.runFile",
                "title": "Run Current File",
                "category": "Zircon",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "zircon.runFile",
                    "when": "editorLangId == zircon",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "zircon.runFile",
                    "when": "editorLangId == zircon"
                }
            ]
        }
    },
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:zircon"
    ],
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.103.0",
        "typescript": "^7.0.2"
    }
}
